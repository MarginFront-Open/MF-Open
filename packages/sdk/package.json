{
  "name": "@marginfront/sdk",
  "version": "0.23.0",
  "private": true,
  "description": "Official Node.js SDK for MarginFront. Track agent usage events, pull revenue / cost / margin / MRR analytics, and manage customers + subscriptions + invoices. One install covers the full billing surface.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "mf": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "marginfront",
    "billing",
    "usage-based",
    "invoicing",
    "sdk",
    "api",
    "metering",
    "subscriptions",
    "revenue-analytics",
    "mrr",
    "ai-agent-billing",
    "llm-billing",
    "agent-monetization"
  ],
  "author": "The MarginFront Authors",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
