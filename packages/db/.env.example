# =============================================================================
# MarginFront database package
# Copy this file to packages/db/.env and edit the two lines below.
# Read by: prisma migrate, prisma generate, and the pricing scripts.
# =============================================================================

# Where the app's data lives. Any PostgreSQL 15 or newer works.
# The default below is a local Postgres with a database named "marginfront".
# Change it when your database is on another host, or needs a password or TLS
# (add ?sslmode=require for hosted databases).
# `npm run db:setup` creates the database for you if it does not exist yet.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marginfront"

# The connection that migrations use. For a plain Postgres, keep it identical
# to DATABASE_URL. Change it only when DATABASE_URL goes through a connection
# pooler (PgBouncer, a "-pooler" host): migrations cannot run through a
# pooler, so this one must point straight at the database.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/marginfront"
