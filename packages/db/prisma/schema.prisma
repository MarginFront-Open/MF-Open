  /// Durable config, so it lives on the subscription, never on the
  /// rebuildable credit_pool_balances cache.
  creditAlertsPaused                Boolean                          @default(false)
  invoices                          invoices[]
  credit_grants                     credit_grants[]
  credit_ledger_entries             credit_ledger_entries[]
  credit_pool_balances              credit_pool_balances?
  pool_alert_events                 pool_alert_events[]
