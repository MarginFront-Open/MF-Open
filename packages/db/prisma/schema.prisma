generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearchPostgres"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // url       — what the app uses at runtime. In serverless envs this should be
  //             a POOLED connection host so a burst of cold instances
  //             shares connections instead of exhausting them.
  url       = env("DATABASE_URL")
  // directUrl — what Prisma CLI commands (migrate deploy/dev/status, db push/pull)
  //             connect with instead of url. Migrations must use the DIRECT host:
  //             running them through PgBouncer is unsupported. The runtime client
  //             never reads this, and `prisma generate` never resolves env(), so
  //             builds don't need the var to exist.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model agents {
  id                          String                        @id @db.Uuid
  name                        String                        @db.VarChar(255)
  description                 String?
  agentCode                   String                        @db.VarChar(255)
  orgId                       String                        @db.Uuid
  isActive                    Boolean?                      @default(true)
  createdAt                   DateTime                      @db.Timestamptz(6)
  updatedAt                   DateTime                      @db.Timestamptz(6)
  deletedAt                   DateTime?                     @db.Timestamptz(6)
  context                     Json?
  agent_pricing_plans         agent_pricing_plans[]
  organizations               organizations                 @relation(fields: [orgId], references: [id], onDelete: NoAction)
  blocks                      blocks[]
  pricing_plans               pricing_plans[]
  pricing_strategies          pricing_strategies[]
  signal_classification_rules signal_classification_rules[]
  signal_events               signal_events[]
  signals                     signals[]
  subscriptions               subscriptions[]

  @@unique([agentCode, orgId])
  @@index([context], type: Gin)
}

model api_key_usage_logs {
  id             String        @id @db.Uuid
  apiKeyId       String        @db.Uuid
  organizationId String        @db.Uuid
  requestTime    DateTime      @db.Timestamptz(6)
  ipAddress      String?       @db.VarChar(255)
  endpoint       String        @db.VarChar(255)
  responseStatus Int?
  metadata       Json?         @default("{}")
  createdAt      DateTime      @db.Timestamptz(6)
  updatedAt      DateTime      @db.Timestamptz(6)
  api_keys       api_keys      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: NoAction)

  @@index([apiKeyId], map: "idx_api_usage_key")
  @@index([organizationId], map: "idx_api_usage_org")
  @@index([requestTime], map: "idx_api_usage_time")
}

model api_keys {
  id                 String                @id @db.Uuid
  name               String                @db.VarChar(255)
  organizationId     String                @db.Uuid
  createdById        String                @db.Uuid
  apiKeyHash         String                @db.VarChar(255)
  apiKeyPlaintext    String?               @db.VarChar(255)
  // Deterministic SHA-256 lookup hash of the raw key. This is
  // what validateApiKey matches on. Computed by the shared
  // hashApiKeyForLookup() helper on write and on verify so they cannot drift.
  apiKeyLookupHash   String?               @db.VarChar(64)
  description        String?               @db.VarChar(255)
  expiresAt          DateTime?             @db.Timestamptz(6)
  status             enum_api_keys_status? @default(active)
  lastUsedAt         DateTime?             @db.Timestamptz(6)
  revokedAt          DateTime?             @db.Timestamptz(6)
  permissions        Json?                 @default("[]")
  metadata           Json?                 @default("{}")
  createdAt          DateTime              @db.Timestamptz(6)
  updatedAt          DateTime              @db.Timestamptz(6)
  deletedAt          DateTime?             @db.Timestamptz(6)
  keyType            enum_api_keys_keyType @default(secret)
  keyPrefix          String?               @db.VarChar(15)
  api_key_usage_logs api_key_usage_logs[]
  users              users                 @relation(fields: [createdById], references: [id], onDelete: NoAction)
  organizations      organizations         @relation(fields: [organizationId], references: [id], onDelete: NoAction)

  @@index([keyType], map: "idx_api_keys_key_type")
  @@index([organizationId, keyType], map: "idx_api_keys_org_type")
  // Plain (non-unique) index so the hash lookup in validateApiKey is fast.
  @@index([apiKeyLookupHash], map: "idx_api_keys_lookup_hash")
}

model blocks {
  id              String             @id @db.Uuid
  organization_id String             @db.Uuid
  agent_id        String?            @db.Uuid
  name            String             @db.VarChar(255)
  type            enum_blocks_type
  status          enum_blocks_status @default(active)
  theme           Json               @default("{\"mode\": \"light\", \"textColor\": \"#1A1A1A\", \"errorColor\": \"#EF4444\", \"fontFamily\": \"system-ui\", \"borderColor\": \"#E5E5E5\", \"borderRadius\": 8, \"primaryColor\": \"#0066FF\", \"successColor\": \"#10B981\", \"backgroundColor\": \"#FFFFFF\", \"secondaryTextColor\": \"#6B7280\"}")
  settings        Json               @default("{}")
  created_at      DateTime           @db.Timestamptz(6)
  updated_at      DateTime           @db.Timestamptz(6)
  deleted_at      DateTime?          @db.Timestamptz(6)
  agents          agents?            @relation(fields: [agent_id], references: [id], onUpdate: NoAction)
  organizations   organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_id], map: "idx_blocks_agent_id")
  @@index([organization_id], map: "idx_blocks_org_id")
  @@index([status], map: "idx_blocks_status")
  @@index([type], map: "idx_blocks_type")
}

model customers {
  id                     String                 @id @db.Uuid
  externalId             String?                @db.VarChar(255)
  name                   String                 @db.VarChar(255)
  email                  String?                @db.VarChar(255)
  phone                  String?                @db.VarChar(255)
  addressLine1           String?                @db.VarChar(255)
  addressLine2           String?                @db.VarChar(255)
  city                   String?                @db.VarChar(255)
  state                  String?                @db.VarChar(255)
  zipCode                String?                @db.VarChar(255)
  country                String?                @db.VarChar(255)
  organizationId         String                 @db.Uuid
  status                 enum_customers_status? @default(active)
  billingContactName     String?                @db.VarChar(255)
  billingContactEmail    String?                @db.VarChar(255)
  metadata               Json?                  @default("{}")
  createdAt              DateTime               @db.Timestamptz(6)
  updatedAt              DateTime               @db.Timestamptz(6)
  deletedAt              DateTime?              @db.Timestamptz(6)
  timezone               String?                @default("UTC") @db.VarChar(255)
  margin                 Json?                  @default("{}")
  invoiceEmailRecipients String[]               @default([]) @db.VarChar(255)
  netTerms               Int                    @default(30)
  currency               String                 @default("USD") @db.VarChar(3)
  isInternal             Boolean                @default(false)
  defaultGlCodeId        String?                @db.Uuid
  chart_of_accounts      chart_of_accounts?     @relation(fields: [defaultGlCodeId], references: [id], onDelete: SetNull)
  organizations          organizations          @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  customer_alerts        customer_alerts[]
  invoices               invoices[]
  portal_magic_links     portal_magic_links[]
  portal_sessions        portal_sessions[]
  signal_events          signal_events[]
  subscriptions          subscriptions[]

  @@unique([externalId, organizationId])
  @@index([externalId, organizationId], map: "idx_customers_external_org")
  @@index([invoiceEmailRecipients], map: "idx_customers_invoice_email_recipients", type: Gin)
  @@index([margin], map: "idx_customers_margin", type: Gin)
  @@index([netTerms], map: "idx_customers_net_terms")
}

/// Portal Sessions (separate from admin dashboard sessions)
model portal_sessions {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid
  organizationId String        @db.Uuid
  token          String        @unique @db.VarChar(255)
  expiresAt      DateTime      @db.Timestamptz(6)
  ipAddress      String?       @db.VarChar(255)
  userAgent      String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  impersonatedBy String?       @db.Uuid
  customers      customers     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  impersonator   users?        @relation("ImpersonatedPortalSessions", fields: [impersonatedBy], references: [id])
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([organizationId])
  @@index([token])
  @@index([expiresAt])
  @@index([impersonatedBy])
  @@map("portal_sessions")
}

/// Portal Magic Link Tokens (for customer email verification)
model portal_magic_links {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid
  organizationId String        @db.Uuid
  token          String        @unique @db.VarChar(255)
  expiresAt      DateTime      @db.Timestamptz(6)
  usedAt         DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  customers      customers     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([customerId])
  @@index([expiresAt])
  @@map("portal_magic_links")
}

model inbound_webhooks {
  id                    String                       @id @db.Uuid
  organization_id       String?                      @db.Uuid
  source                enum_inbound_webhooks_source
  event_type            String                       @db.VarChar(100)
  event_id              String?                      @db.VarChar(255)
  payload               Json
  signature             String?
  status                enum_inbound_webhooks_status @default(pending)
  error_message         String?
  processing_attempts   Int                          @default(0)
  processed_at          DateTime?                    @db.Timestamptz(6)
  processing_started_at DateTime?                    @db.Timestamptz(6)
  created_at            DateTime                     @db.Timestamptz(6)
  updated_at            DateTime                     @db.Timestamptz(6)
  organizations         organizations?               @relation(fields: [organization_id], references: [id], onUpdate: NoAction)

  @@index([event_type], map: "idx_inbound_webhooks_event_type")
  @@index([organization_id], map: "idx_inbound_webhooks_org_id")
  @@index([source, event_id], map: "idx_inbound_webhooks_source_event_id")
  @@index([status], map: "idx_inbound_webhooks_status")
}

model invoice_line_items {
  id                 String                       @id @db.Uuid
  invoiceId          String                       @db.Uuid
  description        String                       @db.VarChar(255)
  quantity           Decimal                      @db.Decimal(12, 2)
  unitPrice          Decimal                      @db.Decimal(12, 2)
  amount             Decimal                      @db.Decimal(12, 2)
  type               enum_invoice_line_items_type
  taxCode            String?                      @db.VarChar(255)
  discountCode       String?                      @db.VarChar(255)
  pricingStrategyId  String?                      @db.Uuid
  metadata           Json?                        @default("{}")
  createdAt          DateTime                     @db.Timestamptz(6)
  updatedAt          DateTime                     @db.Timestamptz(6)
  deletedAt          DateTime?                    @db.Timestamptz(6)
  invoices           invoices                     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  pricing_strategies pricing_strategies?          @relation(fields: [pricingStrategyId], references: [id])

  @@index([invoiceId], map: "idx_invoice_line_items_invoice_id")
  @@index([pricingStrategyId], map: "idx_invoice_line_items_pricing_strategy_id")
}

model invoice_payments {
  id                           String                              @id @db.Uuid
  invoiceId                    String                              @db.Uuid
  amount                       Decimal                             @db.Decimal(12, 2)
  paymentDate                  DateTime                            @db.Timestamptz(6)
  paymentMethod                enum_invoice_payments_paymentMethod
  reference                    String?                             @db.VarChar(255)
  notes                        String?
  recordedBy                   String?                             @db.Uuid
  metadata                     Json?                               @default("{}")
  currency                     String                              @default("USD") @db.VarChar(3)
  status                       enum_invoice_payments_status        @default(succeeded)
  createdAt                    DateTime                            @db.Timestamptz(6)
  updatedAt                    DateTime                            @db.Timestamptz(6)
  deletedAt                    DateTime?                           @db.Timestamptz(6)
  provider_transaction_id      String?                             @db.VarChar(255)
  provider_checkout_session_id String?                             @db.VarChar(255)
  payment_provider_id          String?                             @db.Uuid
  provider_status              String?                             @db.VarChar(50)
  error_code                   String?                             @db.VarChar(100)
  error_message                String?
  refunded_amount              Decimal                             @default(0) @db.Decimal(15, 2)
  refund_status                enum_invoice_payments_refund_status @default(none)
  card_last4                   String?                             @db.VarChar(4)
  card_brand                   String?                             @db.VarChar(20)
  provider_fee                 Decimal?                            @db.Decimal(15, 2)
  net_amount                   Decimal?                            @db.Decimal(15, 2)
  receipt_url                  String?
  receipt_email_sent           Boolean                             @default(false)
  invoices                     invoices                            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment_providers            payment_providers?                  @relation(fields: [payment_provider_id], references: [id], onUpdate: NoAction)
  users                        users?                              @relation(fields: [recordedBy], references: [id], onDelete: NoAction)
  refunds                      refunds[]

  @@index([provider_checkout_session_id], map: "idx_invoice_payments_checkout_session")
  @@index([provider_transaction_id], map: "idx_invoice_payments_provider_tx_id")
  // Cash-basis "Collected" windows on paymentDate on every dashboard
  // render. Without this index that range scan is a full table scan.
  @@index([paymentDate], map: "idx_invoice_payments_payment_date")
}

model invoices {
  id                    String                              @id @db.Uuid
  customerId            String                              @db.Uuid
  subscriptionId        String?                             @db.Uuid
  organizationId        String                              @db.Uuid
  invoiceDate           DateTime                            @db.Timestamptz(6)
  dueDate               DateTime                            @db.Timestamptz(6)
  billingPeriodStart    DateTime                            @db.Timestamptz(6)
  billingPeriodEnd      DateTime                            @db.Timestamptz(6)
  invoiceType           enum_invoices_invoiceType           @default(subscription)
  totalAmount           Decimal                             @db.Decimal(12, 2)
  subtotal              Decimal                             @db.Decimal(12, 2)
  taxAmount             Decimal?                            @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal?                            @default(0) @db.Decimal(12, 2)
  status                enum_invoices_status?               @default(draft)
  invoiceNumber         String                              @db.VarChar(255)
  pdfUrl                String?                             @db.VarChar(255)
  metadata              Json?                               @default("{}")
  currency              String                              @default("USD") @db.VarChar(3)
  netTerms              Int                                 @default(30)
  amountPaid            Decimal                             @default(0) @db.Decimal(12, 2)
  amountCredited        Decimal                             @default(0) @db.Decimal(12, 2)
  amountDue             Decimal                             @default(0) @db.Decimal(12, 2)
  statusReason          String?                             @db.VarChar(255)
  pdfSha256             String?                             @db.VarChar(255)
  autoCollectPayment    Boolean                             @default(false)
  isFinalizedUsage      Boolean?                            @default(false)
  lastUsageUpdateAt     DateTime?                           @db.Timestamptz(6)
  invoiceGenerationType enum_invoices_invoiceGenerationType @default(automatic)
  memo                  String?
  createdAt             DateTime                            @db.Timestamptz(6)
  updatedAt             DateTime                            @db.Timestamptz(6)
  deletedAt             DateTime?                           @db.Timestamptz(6)
  reminderStage         String?                             @default("none") @db.VarChar(20)
  reminderCount         Int?                                @default(0)
  lastReminderSentAt    DateTime?                           @db.Timestamptz(6)
  nextReminderDate      DateTime?                           @db.Date
  reminderPaused        Boolean?                            @default(false)
  escalatedAt           DateTime?                           @db.Timestamptz(6)
  escalationReason      String?
  invoice_line_items    invoice_line_items[]
  invoice_payments      invoice_payments[]
  customers             customers                           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizations         organizations                       @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  subscriptions         subscriptions?                      @relation(fields: [subscriptionId], references: [id], onDelete: NoAction)

  @@unique([organizationId, invoiceNumber], map: "invoices_org_invoiceNumber_unique")
  @@index([customerId], map: "idx_invoices_customer_id")
  @@index([dueDate], map: "idx_invoices_due_date")
  @@index([escalatedAt], map: "idx_invoices_escalated")
  @@index([invoiceGenerationType], map: "idx_invoices_generation_type")
  @@index([invoiceDate], map: "idx_invoices_invoice_date")
  @@index([isFinalizedUsage], map: "idx_invoices_is_finalized_usage")
  @@index([lastUsageUpdateAt], map: "idx_invoices_last_usage_update")
  @@index([nextReminderDate, status, reminderPaused], map: "idx_invoices_reminder_due")
  @@index([reminderStage], map: "idx_invoices_reminder_stage")
  @@index([status], map: "idx_invoices_status")
  @@index([subscriptionId], map: "idx_invoices_subscription_id")
  @@index([subscriptionId, invoiceType, billingPeriodStart], map: "idx_invoices_subscription_type_period")
  @@index([invoiceType], map: "idx_invoices_type")
}

model organizations {
  id                                                 String                                    @id @db.Uuid
  name                                               String                                    @db.VarChar(255)
  slug                                               String?                                   @unique @db.VarChar(255)
  organizationInfo                                   String?
  website                                            String?                                   @db.VarChar(255)
  linkedin                                           String?                                   @db.VarChar(255)
  logo                                               String?                                   @db.VarChar(255)
  createdAt                                          DateTime                                  @default(now()) @db.Timestamptz(6)
  updatedAt                                          DateTime                                  @default(now()) @updatedAt @db.Timestamptz(6)
  timezone                                           String                                    @default("UTC") @db.VarChar(255)
  tagline                                            String?                                   @db.VarChar(255)
  address_line1                                      String?                                   @db.VarChar(255)
  address_line2                                      String?                                   @db.VarChar(255)
  city                                               String?                                   @db.VarChar(255)
  state                                              String?                                   @db.VarChar(255)
  zip_code                                           String?                                   @db.VarChar(255)
  country                                            String?                                   @db.VarChar(255)
  billing_email                                      String?                                   @db.VarChar(255)
  billing_phone                                      String?                                   @db.VarChar(255)
  default_currency                                   String?                                   @default("USD") @db.VarChar(255)
  designjson                                         Json?                                     @default("{\"textColor\": \"#FFFFFF\", \"headerColor\": \"#2B3990\"}")
  stripe_connect_account_id                          String?                                   @db.VarChar(255)
  stripe_connect_type                                String?                                   @default("standard") @db.VarChar(255)
  stripe_connect_charges_enabled                     Boolean?                                  @default(false)
  stripe_connect_details_submitted                   Boolean?                                  @default(false)
  stripe_connect_requirements                        Json?                                     @default("{}")
  stripe_connect_onboarding_url                      String?                                   @db.VarChar(255)
  stripe_connect_onboarding_url_expires              DateTime?                                 @db.Timestamptz(6)
  owner_id                                           String?                                   @db.Uuid
  max_team_size                                      Int?
  team_features                                      Json?                                     @default("{}")
  stripe_connect_status                              enum_organizations_stripe_connect_status?
  onboarding_complete                                Boolean                                   @default(false)
  onboarding_step                                    String?                                   @db.VarChar(255)
  dashboard_mode                                     enum_organizations_dashboard_mode?
  setup_method                                       String?                                   @db.VarChar(50)
  theme                                              Json?
  // Who this org's printed invoices say the bill is from
  // ({ legalName?, addressLine1?, addressLine2?, city?, state?, postalCode?,
  // country?, email? } — all optional, zod-validated in
  // apps/dashboard/app/actions/org-billing-identity.ts). NULL = nothing
  // stored; the invoice print then shows the org display name only, never
  // an invented address or email.
  billingIdentity                                    Json?
  // The customer's own before-AI numbers, which the ROI report's
  // "Without AI" comparison is built from ({ unitSingular?, unitPlural?,
  // beforeAiCostPerUnit?, beforeAiRevenuePerUnit? } — all optional,
  // zod-validated both ways in
  // apps/dashboard/app/actions/org-roi-assumptions.ts). NULL = nothing stored;
  // the report then shows its empty copy and computes nothing. The count of
  // finished work for a window is deliberately NOT here — it is true for one
  // date range only, so it rides in the URL beside the dates.
  roiAssumptions                                     Json?
  // When true, Stripe Checkout sessions for this org's invoices include
  // `automatic_tax: { enabled: true }`, which delegates sales-tax calculation to Stripe Tax
  // against the merchant's own tax registrations. Off by default — the merchant must opt in
  // (and have Stripe Tax configured on their Stripe account) for charges to include tax.
  stripeAutomaticTax                                 Boolean                                   @default(false)
  agents                                             agents[]
  api_key_usage_logs                                 api_key_usage_logs[]
  api_keys                                           api_keys[]
  ba_invitations                                     ba_invitation[]
  ba_members                                         ba_member[]
  blocks                                             blocks[]
  cap_policies                                       cap_policies[]
  cap_policy_events                                  cap_policy_events[]
  chart_of_accounts                                  chart_of_accounts[]
  credit_grants                                      credit_grants[]
  customer_alerts                                    customer_alerts[]
  finance_period_locks                               finance_period_locks[]
  finance_period_lock_events                         finance_period_lock_events[]
  customers                                          customers[]
  inbound_webhooks                                   inbound_webhooks[]
  invoices                                           invoices[]
  org_model_mappings                                 org_model_mappings[]
  users_organizations_owner_idTousers                users?                                    @relation("organizations_owner_idTousers", fields: [owner_id], references: [id], onUpdate: NoAction)
  payment_providers                                  payment_providers[]
  pool_alert_events                                  pool_alert_events[]
  portal_magic_links                                 portal_magic_links[]
  portal_sessions                                    portal_sessions[]
  pricing_plans                                      pricing_plans[]
  pricing_strategies                                 pricing_strategies[]
  raw_ingest_events                                  raw_ingest_events[]
  signal_classification_overrides                    signal_classification_overrides[]
  signal_classification_rules                        signal_classification_rules[]
  signal_events                                      signal_events[]
  signals                                            signals[]
  subscriptions                                      subscriptions[]
  user_organizations                                 user_organizations[]
  users_users_current_organization_idToorganizations users[]                                   @relation("users_current_organization_idToorganizations")
  users_users_organizationIdToorganizations          users[]                                   @relation("users_organizationIdToorganizations")
  initiatives                                        initiatives[]
  user_dashboard_layouts                             user_dashboard_layouts[]
  user_saved_views                                   user_saved_views[]
  matters                                            matters[]
  matter_routing_rules                               matter_routing_rules[]
}

model payment_providers {
  id                String                      @id @db.Uuid
  organization_id   String                      @db.Uuid
  type              enum_payment_providers_type
  code              String                      @db.VarChar(50)
  name              String                      @db.VarChar(100)
  encrypted_secrets String?
  settings          Json                        @default("{}")
  is_default        Boolean                     @default(false)
  is_active         Boolean                     @default(true)
  created_at        DateTime                    @db.Timestamptz(6)
  updated_at        DateTime                    @db.Timestamptz(6)
  deleted_at        DateTime?                   @db.Timestamptz(6)
  invoice_payments  invoice_payments[]
  organizations     organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_payment_providers_org_id")
  @@index([type], map: "idx_payment_providers_type")
}

model pricing_plans {
  id                  String                @id @db.Uuid
  name                String                @db.VarChar(255)
  description         String?               @db.VarChar(255)
  featuresList        Json?
  agentId             String?               @db.Uuid
  orgId               String                @db.Uuid
  isActive            Boolean?              @default(true)
  createdAt           DateTime              @db.Timestamptz(6)
  updatedAt           DateTime              @db.Timestamptz(6)
  deletedAt           DateTime?             @db.Timestamptz(6)
  agent_pricing_plans agent_pricing_plans[]
  agents              agents?               @relation(fields: [agentId], references: [id])
  organizations       organizations         @relation(fields: [orgId], references: [id], onDelete: NoAction)
  pricing_strategies  pricing_strategies[]
  subscriptions       subscriptions[]
}

