/// Generic key/count/window throttle table owned by app code.
/// Used by the portal `/r/<token>` redeem route
/// (key = "portal-redeem:<ip>"), keyed per-IP with a 60s sliding window
/// (max 10 redeems per IP per minute).
///
/// Designed to be extensible — additional endpoints that need a
/// Postgres-backed counter can reuse this table with their own key prefix
/// instead of spawning a new table per use case.
///
/// Nothing deletes stale rows, so rows accumulate over time. Rows with
/// lastEventAt older than 7 days are safe to prune.
model app_throttle {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(255)
  count       Int      @default(0)
  windowStart DateTime @default(now()) @db.Timestamptz(6)
  lastEventAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([key])
  @@map("app_throttle")
}

/// Per-org configurable rules that drive the "Suggest classifications" button on the
/// Cost Management page. Each rule is a case-insensitive substring match against a
/// signal name; the first rule (by ascending priority) that matches assigns its
/// category. `agentId` is optional — when set, the rule only applies to signals on
/// that agent (lets different agents reuse the same signal name with different
/// classifications). `isDefault` marks the seed rules so the UI can offer
/// "Restore defaults" without touching user-added rules.
model signal_classification_rules {
  id        String                    @id @default(uuid()) @db.Uuid
  orgId     String                    @db.Uuid
  pattern   String                    @db.VarChar(255)
  category  enum_signals_costCategory
  priority  Int                       @default(100)
  agentId   String?                   @db.Uuid
  isDefault Boolean                   @default(false)
  createdAt DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)

  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agents        agents?       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([orgId, pattern, agentId])
  @@index([orgId, priority])
}

/// Per-org chart of accounts entries for AI cost coding. Each row is a GL code
/// the accountant maps signals to so the journal-entry export can
/// produce QuickBooks IIF / NetSuite CSV / Xero CSV that posts to the right
/// account. Defaults are seeded from a standard AI-cost chart
/// (5100 AI Inference, 5110 AI Infrastructure, 5120 AI Monitoring, 6800 R&D,
/// 7100 Internal AI Tooling). `isDefault` marks the seed rows so "Restore
/// defaults" can recreate them without touching user-added codes.
model chart_of_accounts {
  id             String                    @id @default(uuid()) @db.Uuid
  orgId          String                    @db.Uuid
  glCode         String                    @db.VarChar(50)
  glName         String                    @db.VarChar(255)
  costCategory   enum_signals_costCategory
  accountingType enum_account_type
  isDefault      Boolean                   @default(false)
  description    String?                   @db.VarChar(1000)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)

  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signals       signals[]
  customers     customers[]

  @@unique([orgId, glCode])
  @@index([orgId])
}

/// Audit log: every time a signal's costCategory is changed, record what was suggested,
/// what the user picked, and how the change was triggered. The data can feed a
/// frequency-based learner ("signals containing X are reclassified to Y 8/10 times —
/// add this as a rule?"). SDK auto-classifications are intentionally NOT logged here —
/// they're deterministic from the environment field, not a learning signal.
model signal_classification_overrides {
  id                 String                                      @id @default(uuid()) @db.Uuid
  orgId              String                                      @db.Uuid
  signalId           String                                      @db.Uuid
  signalNameSnapshot String                                      @db.VarChar(255)
  agentIdSnapshot    String?                                     @db.Uuid
  suggestedCategory  enum_signals_costCategory?
  chosenCategory     enum_signals_costCategory
  userId             String?                                     @db.Uuid
  source             enum_signal_classification_overrides_source
  createdAt          DateTime                                    @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signals       signals       @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([signalId])
}

/// Period lock for the month-end close. When an accountant CLOSES a billing
/// period, the app freezes that period's posted numbers into `snapshot` so a later
/// reclassification (signals.costCategory) or GL remap (signals.glCodeId) can
/// NOT silently rewrite a journal CSV that was already posted to the ledger.
/// The read path (getJournalExport / getJournalAuditDetail /
/// getCostClassificationBreakdown / getDefensibilityScore) serves this frozen
/// snapshot verbatim for a locked window instead of recomputing from live
/// signal state. One lock per (org, period window); reopening deletes the row.
model finance_period_locks {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @db.Uuid
  /// Inclusive UTC window start — equals the value parseWindowFilter resolves
  /// for the period, so the read-path guard matches by exact equality.
  periodStart     DateTime @db.Timestamptz(6)
  /// Inclusive UTC window end (end-of-month 23:59:59.999Z for a past month).
  periodEnd       DateTime @db.Timestamptz(6)
  /// Human label shown in the UI, e.g. "May 2026".
  periodLabel     String   @db.VarChar(255)
  /// Frozen close payload: { version, journal, audit, breakdown, score }. JSON
  /// so the snapshot survives schema drift in the underlying payload shapes.
  snapshot        Json
  /// Snapshot format version — lets a future payload-shape change be detected
  /// and safely degraded to a live recompute instead of crashing.
  snapshotVersion Int      @default(1)
  lockedAt        DateTime @default(now()) @db.Timestamptz(6)
  /// Who closed the books. Nullable so a write never fails if the session user
  /// can't be resolved.
  lockedByUserId  String?  @db.Uuid

  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, periodStart, periodEnd])
  @@index([orgId, periodStart])
  @@map("finance_period_locks")
}

/// Append-only
/// audit trail for closing AND reopening a billing period. Closing the books is
/// a SOX segregation-of-duties control, so every close and every reopen has to
/// leave a durable, queryable "who did it, when" record. The close attribution
/// also lives on finance_period_locks (lockedByUserId/lockedAt) — but a REOPEN
/// deletes that lock row, so this table is the ONLY place a reopen is ever
/// recorded. Rows are written here, never updated or deleted by the app
/// (append-only by convention; not DB-enforced).
model finance_period_lock_events {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  /// Inclusive UTC window start of the period that was closed/reopened — the
  /// same value parseWindowFilter resolves, so it matches
  /// finance_period_locks.periodStart for the same window.
  periodStart DateTime @db.Timestamptz(6)
  /// Inclusive UTC window end of the period.
  periodEnd   DateTime @db.Timestamptz(6)
  /// Human label of the period, e.g. "May 2026" (copied from the lock row so the
  /// audit reads without re-deriving it).
  periodLabel String   @db.VarChar(255)
  /// What happened: 'closed' or 'reopened'. A plain String (not a Postgres enum)
  /// because a 2-value field doesn't justify a new enum type — same call as
  /// ba_member.role / ba_invitation.status, which are plain VarChar.
  action      String   @db.VarChar(20)
  /// Who did it. Nullable on purpose (mirrors finance_period_locks.lockedByUserId)
  /// so an audit write can never fail just because the session user can't be
  /// resolved. Intentionally diverges from subscription_change_logs.changedBy
  /// (non-null) — an audit write must not throw.
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, periodStart])
  @@map("finance_period_lock_events")
}

/// A user's saved tile layout for
/// one dashboard page (Money/FinOps/Build/ROI/MF IQ). No-row = the page's
/// code-default layout; "reset" deletes the row rather than writing a
/// synthetic default back. `page` is code-validated against the catalog's
/// page ids (no pg enum, so adding a page needs no migration). `tiles` is
/// catalog-validated server-side (component/dimension/
/// size whitelists) before it's ever written — see
/// apps/dashboard/src/lib/component-catalog.ts.
model user_dashboard_layouts {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  orgId         String        @db.Uuid
  page          String        @db.VarChar(50) // code-validated against DASHBOARD_PAGE_IDS; no pg enum, so adding a page needs no migration
  tiles         Json // [{ component, dimension?, size }] — catalog-validated (below)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, page])
  @@index([orgId])
}

/// A user's named filter preset — a saved
/// (page, dimension, period, entity-filter) combination they can re-apply
/// with one click. `filters` carries its own scope (page/dimension/period/
/// customerId/etc.) rather than being tied to a fixed column shape, since
/// which filters apply differs per page.
model user_saved_views {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  orgId         String        @db.Uuid
  name          String        @db.VarChar(255)
  filters       Json // { page?, dimension?, period?, customerId?, ... } — scope lives inside
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, name])
  @@index([userId, orgId])
}

/// An org-level goal with a start/end
/// window ("the ROI page's window"). Org-content, not per-user personalization
/// — writes are money writes (assertMoneyManager), same as chart_of_accounts.
/// Targets are manual only; actuals are computed at read time from canon
/// over the initiative's window, never stored.
model initiatives {
  id                 String               @id @default(uuid()) @db.Uuid
  orgId              String               @db.Uuid
  name               String               @db.VarChar(255)
  description        String?              @db.VarChar(1000)
  status             String               @default("active") @db.VarChar(20) // 'active'|'archived' — code-validated, no pg enum
  startDate          DateTime             @db.Timestamptz(6) // the ROI page's window
  endDate            DateTime?            @db.Timestamptz(6) // null = ongoing
  /// The ONE matter this initiative measures, or null for the
  /// whole organization. SetNull mirrors signal_events.matterId — deleting a
  /// matter never deletes the goal that pointed at it; the initiative simply
  /// falls back to org-wide reads.
  matterId           String?              @db.Uuid
  /// The matter's number as it read when the scope was set. Written and
  /// cleared by the same action that writes matterId, so SetNull cannot
  /// erase it — it is the ONLY trace that a deleted matter was ever the
  /// scope, and the card's "the matter this initiative pointed at was
  /// deleted" line is the one thing that reads it. Never the display source
  /// while matterId is set (the relation is, so a renumbered matter reads
  /// fresh).
  scopedMatterNumber String?              @db.VarChar(255)
  createdByUserId    String?              @db.Uuid // attribution-only; nullable like finance_period_locks.lockedByUserId
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  organizations      organizations        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  matters            matters?             @relation(fields: [matterId], references: [id], onDelete: SetNull)
  initiative_targets initiative_targets[]

  @@index([orgId, status])
  @@index([matterId])
}

/// One manual target for an initiative
/// — a metric, a goal value, and which side of it is "good" (lte/gte). No
/// uniqueness on (initiativeId, metric): the write action treats the set of
/// targets for an initiative as replace-all, not per-metric upsert.
model initiative_targets {
  id             String      @id @default(uuid()) @db.Uuid
  initiativeId   String      @db.Uuid
  metric         String      @db.VarChar(50) // code-validated registry: 'cost'|'revenue'|'margin'|'marginPercent'|'costPerTask'|'eventCount'|'unmappedCount'
  targetValue    Decimal     @db.Decimal(18, 6) // dollars for money metrics per canon U1/U3 (bare name = dollars)
  baselineValue  Decimal?    @db.Decimal(18, 6) // starting value; null = no baseline, progress falls back to the no-baseline forms
  baselineSource String?     @db.VarChar(10) // 'auto' = measured from org data as of startDate, 'manual' = typed by a person; null = treated as manual
  direction      String      @db.VarChar(4) // 'lte'|'gte' — is under or over the goal
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  initiatives    initiatives @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@index([initiativeId])
}

/// A spend-cap policy for AI coding-agent spend,
/// set by a non-technical decision-maker (owner/finance only) and enforced
/// device-side by the code-cost-clarity meter's brake. The hierarchy is org ceiling -> optional
/// team/dev caps beneath it, never above it; that rule is enforced in the
/// SHARED validation path (packages/db/src/lib/cap-policy.ts), used by every
/// write, not just one controller. This is STORAGE + read-back only: there is
/// NO server-side enforcement. The device pulls the spend read-back plus this
/// policy and brakes itself, failing open on stale/unreachable state.
model cap_policies {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @db.Uuid
  /// Who this cap governs: 'org' (the ceiling), 'team', or 'dev'.
  scope           String   @db.VarChar(20)
  /// The scope's target. 'dev' -> the developer's customerExternalId (the email
  /// that IS the per-dev attribution key on signal_events). 'team' -> an
  /// org-defined team label. 'org' -> null (one ceiling per org + provider).
  scopeValue      String?  @db.VarChar(255)
  /// Which provider's spend this cap governs: 'all', or one provider matching
  /// the modelProvider string stored on signal_event_services
  /// ('anthropic' | 'openai' | 'google' | 'xai' | ...).
  providerScope   String   @db.VarChar(50)
  /// Cap amount in dollars (CANON U1). 6 decimals for parity with
  /// signal_events.usageCost so a cap can be compared to spend without a scale hop.
  amountUsd       Decimal  @db.Decimal(18, 6)
  /// Reset cadence: 'day' | 'week' | 'month'. Windows roll at UTC (platform-owned
  /// so every device agrees on the boundary); computed by currentPeriodWindow().
  period          String   @db.VarChar(20)
  /// 'track' (watch + alert, blocks nothing) or 'enforce' (device hard-stops).
  /// EXACTLY these two names, the same mode vocabulary credit pools use, so
  /// there is one mental model across the whole product.
  mode            String   @db.VarChar(20)
  /// Optional cool-off window in hours: after a cap trips, how long the device
  /// keeps braking before it re-evaluates. Null = no cool-off.
  coolOffHours    Int?
  /// The alert ladder — whole percents of this cap
  /// (default 50/80/100) at which a heads-up email fires. Org-configurable via
  /// the cap create/update API; bounds (1..100, <=5 entries, strictly ascending)
  /// are enforced in the write DTO.
  alertThresholds Int[]    @default([50, 80, 100])
  /// Attribution-only: who last wrote this policy. Nullable so a write never
  /// fails when the session user can't be resolved (mirrors finance_period_locks).
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organizations    organizations      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cap_alert_events cap_alert_events[]

  /// One cap per (org, scope, scopeValue, provider). A team/dev cap is unique by
  /// its scopeValue; the single org ceiling (scopeValue = NULL) is additionally
  /// kept unique per provider in the write path (Postgres treats NULLs as
  /// distinct, so the DB constraint alone can't dedupe the ceiling).
  @@unique([orgId, scope, scopeValue, providerScope])
  @@index([orgId])
  @@map("cap_policies")
}

/// Append-only audit trail for cap-policy writes.
/// The product's core trust claim ("the cap that actually caps") collapses
/// without a durable record of who changed which cap, when. Mirrors finance_period_lock_events: a
/// plain-String action, a nullable actorUserId so an audit write can never
/// throw, and rows are written but never updated or deleted by the app.
model cap_policy_events {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  /// The policy this event describes. Nullable because a 'deleted' event
  /// outlives the cap_policies row it references (that row is gone).
  capPolicyId    String?  @db.Uuid
  /// 'created' | 'updated' | 'deleted'. A plain String, not a Postgres enum — a
  /// small closed set doesn't justify a new enum type (same call as
  /// finance_period_lock_events.action).
  action         String   @db.VarChar(20)
  /// Policy state before this change (null on create).
  previousValues Json?
  /// Policy state after this change (null on delete).
  newValues      Json?
  /// Who did it. Nullable on purpose so an audit write never fails just because
  /// the session user can't be resolved.
  actorUserId    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("cap_policy_events")
}

/// The persistent dedup ledger for ladder alerts.
/// One row per (cap, rung, period-window): the unique key makes a rung's alert
/// fire exactly ONCE per period window, idempotent across cron re-runs. The
/// windowStart is part of the key so a fresh period re-arms every rung. Rows
/// FK-cascade with their cap — once a cap is gone, its alert history is moot.
model cap_alert_events {
  id          String   @id @default(uuid()) @db.Uuid
  capPolicyId String   @db.Uuid
  /// The rung that fired, as a whole percent (matches a cap_policies.alertThresholds entry).
  rung        Int
  /// The UTC period-window start this alert belongs to (currentPeriodWindow().start).
  windowStart DateTime @db.Timestamptz(6)
  sentAt      DateTime @default(now()) @db.Timestamptz(6)
  /// The address the alert went to (the org's billingIdentity.email at send time).
  recipient   String   @db.VarChar(255)

  cap_policies cap_policies @relation(fields: [capPolicyId], references: [id], onDelete: Cascade)

  @@unique([capPolicyId, rung, windowStart])
  @@map("cap_alert_events")
}

/// One row per bucket of credit granted to a
/// subscription. The pool balance is DERIVED from credit_ledger_entries and
/// recomputable at any time (lib/credit-ledger.ts computeBalance); the
/// denormalized consumedUnits here lets the draw path pick grants without
/// replaying history. Track-only: these rows never gate ingest.
model credit_grants {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @db.Uuid
  organizationId String    @db.Uuid
  /// Units granted, denominated in USAGE UNITS (the event's billable
  /// quantity — the same number the invoice bills). NEVER dollars and never
  /// usageCost.
  amountUnits    Decimal   @db.Decimal(18, 6)
  /// Units drawn from this grant so far, maintained in the same transaction
  /// as the ledger append. MAY exceed amountUnits on the grant covering the
  /// current period — that overdraw IS the truthful negative balance track
  /// mode shows as overage-in-progress.
  consumedUnits  Decimal   @default(0) @db.Decimal(18, 6)
  /// 'period_grant' | 'manual_topup' | 'adjustment'.
  /// Plain String, not a Postgres enum — a small closed set doesn't justify
  /// a new enum type (house style, same as cap_policy_events.action).
  source         String    @db.VarChar(30)
  /// The subscription billing period this grant was minted for. Set on
  /// period_grant rows, so a second mint can't stack another full pool onto
  /// the same period. NULL on top-ups and
  /// adjustments; Postgres treats NULLs as distinct, so those never collide
  /// with the unique key below.
  periodStart    DateTime? @db.Timestamptz(6)
  effectiveAt    DateTime  @db.Timestamptz(6)
  /// Period grants expire at the period's currentBillingPeriodEnd. NULL =
  /// never expires (top-ups/adjustments unless the writer says otherwise).
  expiresAt      DateTime? @db.Timestamptz(6)
  /// Caller-supplied retry-safety key for manual top-ups/adjustments. NULL =
  /// no key; NULLs are distinct.
  idempotencyKey String?   @unique @db.VarChar(255)
  /// The audit half of an auditable grant: the operator note on manual
  /// writes. "Why does customer
  /// X have 3,214 credits?" is answered from the row itself.
  note           String?
  /// Who/what minted it: 'dispatch:usage-invoice' | 'activation' |
  /// 'lazy-mint' | a user id on manual writes.
  createdBy      String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  subscriptions         subscriptions           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organizations         organizations           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credit_ledger_entries credit_ledger_entries[]

  /// THE mint-idempotency key: one period grant per (subscription, period),
  /// whichever code path advanced the period (dispatch, activation, lazy).
  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId, expiresAt])
  @@index([organizationId])
  @@map("credit_grants")
}

/// The append-only movement log. One row per pool movement;
/// rows are written, never updated or deleted by the app. balanceAfterUnits
/// makes audit reads O(1) instead of a replay.
model credit_ledger_entries {
  id                String   @id @default(uuid()) @db.Uuid
  grantId           String   @db.Uuid
  subscriptionId    String   @db.Uuid
  /// 'grant' | 'consume' | 'expire' | 'adjust'. Plain String (house style).
  kind              String   @db.VarChar(20)
  /// Signed movement in usage units. Negative = consumption/expiry.
  deltaUnits        Decimal  @db.Decimal(18, 6)
  /// Pool balance after this entry (negative = overage-in-progress).
  balanceAfterUnits Decimal  @db.Decimal(18, 6)
  /// Set on consume rows: the signal_events row that drew the units — every
  /// decrement traces to an event. NULL on grant/expire/adjust rows.
  signalEventId     String?  @db.Uuid
  /// Audit only: the credits-per-unit rate this consume row's draw
  /// used (the row's share of event units × rateApplied = -deltaUnits). NULL
  /// means rate 1, every unrated draw. No read path
  /// computes from it; it exists so "why did 30 units burn 120 credits?" is
  /// answered from the row itself, including after the strategy's rates change.
  rateApplied       Decimal? @db.Decimal(18, 6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  credit_grants credit_grants @relation(fields: [grantId], references: [id], onDelete: Cascade)
  subscriptions subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// An ingest retry can't double-decrement: one consume row per
  /// (event, grant). NULL signalEventIds are distinct, so grant/expire
  /// bookkeeping rows never collide.
  @@unique([signalEventId, grantId])
  @@index([subscriptionId, createdAt])
  @@map("credit_ledger_entries")
}

/// The per-subscription cached balance. An OPTIMIZATION, never
/// truth: created by upsert on first consume and at mint, NEVER assumed to
/// exist. Recomputable from the ledger at any
/// time; the ledger wins every disagreement.
model credit_pool_balances {
  subscriptionId String   @id @db.Uuid
  /// Current pool balance in usage units. Negative = overage-in-progress
  /// (track mode bills it as ordinary overage at period close; nothing gates).
  balanceUnits   Decimal  @db.Decimal(18, 6)
  /// The billing period this cache row describes. Cross-period draws (a
  /// buffered flush billing into a prior period) skip the cache entirely —
  /// consumeUnits only touches it for events inside the current period. The
  /// decrement's WHERE guard on this column exists to catch a STALE row a
  /// missed mint left behind: a guard miss falls back to recompute-and-SET
  /// (heal), never a blind decrement.
  periodStart    DateTime @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  subscriptions subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("credit_pool_balances")
}

/// The persistent dedup ledger for staged pool
/// alerts, sibling of cap_alert_events. One row per (subscription, stage,
/// billing period): the unique key makes a stage's alert fire exactly ONCE
/// per period, idempotent across cron re-runs and the ingest trigger.
/// periodStart is part of the key so a fresh billing period re-arms every
/// stage; boundary evaluations of a just-ended period record under the OLD
/// periodStart. Append-only: rows are written, never updated or deleted by
/// the app.
model pool_alert_events {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @db.Uuid
  organizationId String   @db.Uuid
  /// 'pool_50' | 'pool_80' | 'pool_95' | 'pool_exhausted'. Plain String, not
  /// a Postgres enum (house style, same as credit_grants.source).
  stage          String   @db.VarChar(20)
  /// The subscription billing period this alert belongs to (currentBillingPeriodStart,
  /// or the ended period's start on a boundary evaluation).
  periodStart    DateTime @db.Timestamptz(6)
  sentAt         DateTime @default(now()) @db.Timestamptz(6)
  /// Who the alert went to (join-then-truncate guarded to fit 255).
  recipient      String   @db.VarChar(255)

  subscriptions subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organizations organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, stage, periodStart])
  @@index([organizationId])
  @@map("pool_alert_events")
}

/// A per-customer cost/revenue watch ("email me when Acme's cost
/// passes $500 this month"). Same engine shape as the cap and pool alerts, pointed
/// at REAL customers (customers.isInternal = false), never internal coding-agent spend.
/// Windows mirror the dashboard period selector: 'month' (current UTC calendar
/// month), 'rolling' (last 30 days), 'custom' (fixed range; expires at range
/// end). Value is read through the canonical getCostMetrics/getRevenueMetrics
/// with a customerId filter — this table stores the tripwire, never money math.
model customer_alerts {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @db.Uuid
  customerId      String    @db.Uuid
  /// 'cost' | 'revenue'. Plain String + DTO validation, not a Postgres enum
  /// (house style, same as cap_policies.mode), so adding a metric such as
  /// margin is a value add, not a migration.
  metric          String    @db.VarChar(20)
  /// Threshold in dollars (canon U1). 6 decimals for parity with
  /// signal_events.usageCost so the compare needs no scale hop.
  thresholdUsd    Decimal   @db.Decimal(18, 6)
  /// 'month' | 'rolling' | 'custom' — the dashboard period selector's own vocabulary.
  windowMode      String    @db.VarChar(20)
  /// Custom mode only: the fixed evaluation range. Null in the other modes.
  customStartDate DateTime? @db.Timestamptz(6)
  customEndDate   DateTime? @db.Timestamptz(6)
  /// Attribution-only: who created the watch. Nullable because API-key/MCP
  /// creates carry no session user (mirrors cap_policies.createdByUserId).
  createdByUserId String?   @db.Uuid
  /// The deliverable address, resolved ONCE at create time (session creator's
  /// email, or the money-role member an MCP caller named via notify_email) and
  /// stored so a fire never depends on a live user lookup — survives creator
  /// deletion. Re-resolved from users.email on session PATCH; otherwise the
  /// stored address can go stale.
  recipientEmail  String    @db.VarChar(255)
  /// The org member the stored email belonged to at create time — who the
  /// in-app notification rows (customer_alert_notifications.userId) belong to.
  recipientUserId String    @db.Uuid
  /// Rolling-mode latch: set when a crossing fires, cleared when the value
  /// reads back under threshold (silent re-arm). One email per crossing
  /// episode, not one per day over. Null in month/custom modes.
  triggeredAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organizations                organizations                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customers                    customers                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customer_alert_events        customer_alert_events[]
  customer_alert_notifications customer_alert_notifications[]

  /// The DB backstop under the service's duplicate findFirst guards
  /// (create + update) — mirrors their functional tuple exactly. The migration
  /// SQL adds NULLS NOT DISTINCT (PG15+; Prisma can't express it here) so two
  /// month/rolling watches with NULL custom dates still collide.
  @@unique([orgId, customerId, metric, windowMode, thresholdUsd, recipientUserId, customStartDate, customEndDate], map: "uq_customer_alerts_functional_tuple")
  @@index([orgId])
  @@index([customerId])
  @@map("customer_alerts")
}

/// The persistent dedup ledger for customer watches (same shape as
/// cap_alert_events). One row per (alert, window): the unique key makes a
/// watch fire exactly once per window, idempotent across cron re-runs.
/// windowStart per mode: month = the UTC month start; custom = customStartDate
/// (one fire ever); rolling = UTC day-start of the fire moment (the race belt
/// under the triggeredAt latch). Rows cascade with their alert.
model customer_alert_events {
  id          String   @id @default(uuid()) @db.Uuid
  alertId     String   @db.Uuid
  windowStart DateTime @db.Timestamptz(6)
  /// The metric value (dollars) at fire time, for copy and audit.
  valueUsd    Decimal  @db.Decimal(18, 6)
  /// The address the alert went to (the watch's stored recipientEmail at send time).
  recipient   String   @db.VarChar(255)
  sentAt      DateTime @default(now()) @db.Timestamptz(6)

  customer_alerts customer_alerts @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, windowStart])
  @@map("customer_alert_events")
}

/// The in-app notification feed: one row per
/// fire per recipient, feeding the MFiQ "Customer alerts" card and the red
/// sidebar badge. readAt is the per-user read state (null = unread; the badge
/// count query is WHERE userId = ? AND readAt IS NULL, hence the composite
/// index). Alert facts (metric/threshold/value/windowMode) are denormalized so
/// the feed renders without joining a row the user may since have edited.
/// Rows cascade with their alert — deleting a watch clears its feed.
model customer_alert_notifications {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  /// The recipient (the watch's recipientUserId at fire time). Reads are always
  /// scoped userId = session user AND orgId = active org, so a person in two
  /// orgs never sees org A's customers while working in org B.
  userId       String    @db.Uuid
  alertId      String    @db.Uuid
  customerId   String    @db.Uuid
  metric       String    @db.VarChar(20)
  thresholdUsd Decimal   @db.Decimal(18, 6)
  valueUsd     Decimal   @db.Decimal(18, 6)
  windowMode   String    @db.VarChar(20)
  firedAt      DateTime  @default(now()) @db.Timestamptz(6)
  readAt       DateTime? @db.Timestamptz(6)

  customer_alerts customer_alerts @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([orgId])
  @@map("customer_alert_notifications")
}

/// A legal matter/case an org bills
/// AI usage against. matterNumber is the firm's own case identifier — unique per
/// org, matched EXACTLY (trimmed) against metadata.matterId at ingest. Bar rules
/// (ABA Op. 512, FL 24-1, OR 2025-205) require ACTUAL per-matter AI cost before
/// a firm may bill AI work; signal_events.matterId is what makes that record exist.
model matters {
  id                String              @id @default(uuid()) @db.Uuid
  orgId             String              @db.Uuid
  matterNumber      String              @db.VarChar(255)
  name              String              @db.VarChar(255)
  clientName        String              @db.VarChar(255)
  status            enum_matters_status @default(open)
  /// Responsible timekeeper. Plain uuid, no FK across the auth tables, so it
  /// tolerates a departed user. No UI sets it; server actions pass it through
  /// unchanged.
  responsibleUserId String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  organizations        organizations          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signal_events        signal_events[]
  matter_routing_rules matter_routing_rules[]
  initiatives          initiatives[]

  @@unique([orgId, matterNumber])
  @@index([orgId, status])
}

/// Org-defined routing rules that sweep UNTAGGED usage events onto a
/// matter — same shape as signal_classification_rules (priority asc, first match
/// wins) with matter-shaped matchers. A rule matches when EVERY set matcher
/// matches (agentCode exact, customerExternalId exact, signalPattern
/// case-insensitive substring); at least one matcher is required, enforced in
/// the server action. A direct metadata.matterId tag always beats a rule.
model matter_routing_rules {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @db.Uuid
  matterId           String   @db.Uuid
  priority           Int      @default(100)
  agentCode          String?  @db.VarChar(255)
  customerExternalId String?  @db.VarChar(255)
  signalPattern      String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organizations organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  matters       matters       @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([orgId, priority])
}

enum enum_matters_status {
  open
  closed
}

enum enum_signal_events_matterSource {
  tag
  rule
  manual
}
