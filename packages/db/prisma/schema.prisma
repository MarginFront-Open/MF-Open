  @@index([email])
  @@map("ba_invitation")
}

/// Normalized pricing catalog for LLM models and third-party API services.
/// Synced from OpenRouter + LiteLLM, plus the built-in rows in scripts/sync-service-pricing.ts.
/// Users pick from this table when setting up agent metrics.
model service_pricing {
  id                    String                  @id @default(uuid()) @db.Uuid
  externalId            String                  @unique @db.VarChar(255)
  displayName           String                  @db.VarChar(255)
  provider              String                  @db.VarChar(100)
  serviceType           String                  @db.VarChar(50)
  /// Money in dollars PER costUnit (CANON U1 = dollars, not cents). For LLM rows (costUnit '1M tokens') this is dollars per MILLION tokens — a $3/1M-token model stores 3, NOT 0.000003: sync-service-pricing.ts writes rate×1,000,000 and calculateEventCost divides by 1,000,000. For non-token rows it's dollars per the named unit ('1K requests', 'minute', ...).
  inputCost             Decimal?                @db.Decimal(18, 10)
  /// Money in dollars PER costUnit — dollars per MILLION tokens on LLM rows (CANON U1). See inputCost above.
  outputCost            Decimal?                @db.Decimal(18, 10)
  /// Money in dollars per MILLION cache-READ tokens on LLM rows (CANON U1; same per-costUnit convention as inputCost). The price of reading tokens back out of the provider's prompt cache (a cache "hit") — ~0.1× inputCost on Anthropic. Null for non-LLM rows and for sources that don't expose cache pricing.
  cacheReadCost         Decimal?                @db.Decimal(18, 10)
  /// Money in dollars per MILLION cache-WRITE tokens on LLM rows (CANON U1; same per-costUnit convention as inputCost). The price of writing tokens INTO the prompt cache (cache creation). On Anthropic LLM rows the sync script (scripts/sync-service-pricing.ts) OVERRIDES the feed value and stores the 1-hour-TTL ceiling (2× inputCost) so an unknown TTL can never under-bill; an event that proves the 5-minute flavor (metadata.cacheWriteTtl = "5m") is priced at 1.25× inputCost via applyCacheWriteTtl in model-pricing.ts. Null for non-LLM/cache-less rows.
  cacheWriteCost        Decimal?                @db.Decimal(18, 10)
  costUnit              String                  @db.VarChar(50)
  contextWindow         Int?
  source                String                  @db.VarChar(50)
  isApi                 Boolean                 @default(false)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)
  canonicalName         String                  @db.VarChar(255)
  org_model_mappings    org_model_mappings[]
  signal_services       signal_services[]
  signal_event_services signal_event_services[]

  @@index([serviceType])
  @@index([provider])
  @@index([source])
  @@index([provider, canonicalName, isActive])
  @@map("service_pricing")
}

/// Links a metric (signal) to the services it uses.
/// Example: "Summarize document" uses an LLM plus a web search API.
/// This is the join table that enables "Cost Breakdown by Service" queries.
model signal_services {
  id               String          @id @default(uuid()) @db.Uuid
  signalId         String          @db.Uuid
  servicePricingId String          @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  service_pricing  service_pricing @relation(fields: [servicePricingId], references: [id], onDelete: Cascade)
  signals          signals         @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId, servicePricingId])
  @@index([signalId])
  @@index([servicePricingId])
  @@map("signal_services")
}

/// Per-service cost breakdown for a signal_event. Mirrors the
/// invoices -> invoice_line_items pattern: the parent signal_events row
/// holds the aggregated usageCost (sum across children); each child row
/// records ONE service's contribution (model, provider, volume, cost).
///
/// Single-service events have one child row. Multi-service events (one
/// business outcome backed by multiple services such as Claude tokens
/// plus Google Maps queries) have one parent and N children.
///
/// Status mirrors the parent's enum so per-service status is visible:
/// a child can be PROCESSED with cost, NEEDS_COST_BACKFILL when its
/// model is not yet mapped, or MISSING_VOLUME_DATA when tokens or
/// quantity are absent. Parent status is derived from children
/// (canon: parent.usageCost = SUM(children.usageCost) when all children
/// resolved, else null).
model signal_event_services {
  id               String                            @id @default(uuid()) @db.Uuid
  signalEventId    String                            @db.Uuid
  model            String                            @db.VarChar(255)
  modelProvider    String                            @db.VarChar(100)
  inputTokens      Int?
  outputTokens     Int?
  /// Cache-READ tokens for this service (prompt-cache hits). Priced at service_pricing.cacheReadCost. Null when the caller sent no cache counts.
  cacheReadTokens  Int?
  /// Cache-WRITE tokens for this service (prompt-cache creation). Priced at service_pricing.cacheWriteCost. Null when absent.
  cacheWriteTokens Int?
  quantity         Decimal?                          @db.Decimal(18, 6)
  servicePricingId String?                           @db.Uuid
  /// Money in dollars (CANON U1). Per-service breakdown of signal_events.usageCost; same precision rationale.
  usageCost        Decimal?                          @db.Decimal(18, 6)
  usageCostData    Json?
  eventStatus      enum_signal_events_eventProcessed @default(PENDING)
  createdAt        DateTime                          @default(now()) @db.Timestamptz(6)
  signal_events    signal_events                     @relation(fields: [signalEventId], references: [id], onDelete: Cascade)
  service_pricing  service_pricing?                  @relation(fields: [servicePricingId], references: [id], onDelete: SetNull)

  @@index([signalEventId], map: "idx_signal_event_services_event")
  @@index([servicePricingId], map: "idx_signal_event_services_pricing")
  @@index([model, modelProvider], map: "idx_signal_event_services_model")
  @@index([eventStatus], map: "idx_signal_event_services_status")
  @@map("signal_event_services")
}

/// Org-scoped model mappings. When a customer maps an unknown model string
/// to a known service_pricing entry, the mapping lives here — private to
/// that org. The global service_pricing catalog is never written to by customers.
model org_model_mappings {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  sourceModel     String          @db.VarChar(255)
  sourceProvider  String          @db.VarChar(100)
  targetPricingId String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  organizations   organizations   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service_pricing service_pricing @relation(fields: [targetPricingId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceModel, sourceProvider])
  @@index([organizationId, sourceModel, sourceProvider])
  @@map("org_model_mappings")
}

