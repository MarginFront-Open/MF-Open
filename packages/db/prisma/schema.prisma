  subscriptionDetails               Json?                            @default("{}")
  billingCycle                      enum_subscriptions_billingCycle? @default(monthly)
  /// Money in dollars (CANON U1). 6 decimals are available on the column; callers store ≤2, set straight from the DTO with no further math.
  proratedAmount                    Decimal?                         @db.Decimal(10, 6)
  cycleNumber                       Int                              @default(0)
  timezone                          String                           @default("UTC") @db.VarChar(255)
