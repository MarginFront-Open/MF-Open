  pricing_plans                     pricing_plans                    @relation(fields: [planId], references: [id], onDelete: NoAction)

  @@index([agentId, customerId, status], map: "idx_subscriptions_agent_customer_status")
  @@index([currentBillingPeriodStart, currentBillingPeriodEnd], map: "idx_subscriptions_current_billing_period")
  @@index([customerId, status], map: "idx_subscriptions_customer_status")
  @@index([endDate], map: "idx_subscriptions_end_date")
  @@index([nextRecurringInvoiceAt], map: "idx_subscriptions_next_recurring_invoice")
  @@index([nextUsageInvoiceAt], map: "idx_subscriptions_next_usage_invoice")
  @@index([startDate], map: "idx_subscriptions_start_date")
  @@index([status], map: "idx_subscriptions_status")
  @@index([status, endDate], map: "idx_subscriptions_status_end_date")
  @@index([status, startDate], map: "idx_subscriptions_status_start_date")
}

