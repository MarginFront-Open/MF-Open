  @@index([organizationId], map: "idx_raw_ingest_events_org")
  @@index([organizationId, status, createdAt], map: "idx_raw_ingest_events_org_status_created")
  @@index([payload(ops: JsonbPathOps)], map: "idx_raw_ingest_events_payload_gin", type: Gin)
  @@index([receivedAt], map: "idx_raw_ingest_events_received_at")
  @@index([status], map: "idx_raw_ingest_events_status")
}

model refunds {
  id                 String              @id @db.Uuid
  invoice_payment_id String              @db.Uuid
  amount             Decimal             @db.Decimal(15, 2)
  currency           String              @default("USD") @db.VarChar(3)
  reason             String?             @db.VarChar(100)
  status             enum_refunds_status @default(pending)
  /// Unique provider-side refund identifier (e.g. Stripe re_xxx).
  /// Unique to prevent webhook-retry
  /// double-counting. PostgreSQL treats multiple NULLs as distinct so refunds that
  /// haven't received a provider id yet (status=pending pre-webhook) don't collide.
  provider_refund_id String?             @unique @db.VarChar(255)
  error_code         String?             @db.VarChar(100)
  error_message      String?
  refunded_by        String?             @db.Uuid
  created_at         DateTime            @db.Timestamptz(6)
  updated_at         DateTime            @db.Timestamptz(6)
  processed_at       DateTime?           @db.Timestamptz(6)
  invoice_payments   invoice_payments    @relation(fields: [invoice_payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?              @relation(fields: [refunded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoice_payment_id], map: "idx_refunds_payment_id")
  @@index([provider_refund_id], map: "idx_refunds_provider_id")
  @@index([status], map: "idx_refunds_status")
}

model signal_events {
  id                    String                            @id @db.Uuid
  customerExternalId    String                            @db.VarChar(255)
  customerId            String                            @db.Uuid
  subscriptionId        String?                           @db.Uuid
  organizationId        String                            @db.Uuid
  agentId               String                            @db.Uuid
  signalId              String?                           @db.Uuid
  rawIngestEventId      String                            @db.Uuid
  usageDate             DateTime                          @db.Timestamptz(6)
  quantity              Decimal?                          @default(1) @db.Decimal(18, 6)
  metadata              Json?                             @default("{}")
  /// Money in dollars (CANON U1). 6 decimals so per-token LLM cost math (tokens × service_pricing.inputCost) keeps precision until R4 rounds at the presentation leaf.
  usageCost             Decimal?                          @db.Decimal(18, 6)
  usageCostData         Json?
  eventProcessed        enum_signal_events_eventProcessed @default(PENDING)
  eventProcessedAt      DateTime?                         @db.Timestamptz(6)
  environment           enum_signal_events_environment?
  /// Client-supplied idempotency key for exactly-once metering.
  /// A repeat ingest with the same (organizationId, idempotencyKey) is collapsed
  /// to the original event instead of creating a duplicate. Keyed on this SUCCESS
  /// artifact (not raw_ingest_events) so a FAILED attempt — which never reaches
  /// this row — is free to retry, while a SUCCEEDED turn replays as a no-op.
  /// NULL = no key supplied (SDK callers who opt out); PostgreSQL treats multiple
  /// NULLs as distinct, so keyless events never collide — same trick as
  /// refunds.provider_refund_id above.
  idempotencyKey        String?                           @db.VarChar(255)
  /// Which legal matter this event's AI cost bills to. NULL = Unassigned
  /// (a visible bucket on the Law tab, never a silent drop). SetNull on matter
  /// delete so the event survives its matter; deleteMatter also clears matterSource.
  matterId              String?                           @db.Uuid
  /// HOW the event landed on its matter — tag (metadata.matterId at
  /// ingest), rule (matter_routing_rules), or manual (operator). Audit exports
  /// print this per row.
  matterSource          enum_signal_events_matterSource?
  createdAt             DateTime                          @db.Timestamptz(6)
  updatedAt             DateTime                          @db.Timestamptz(6)
  agents                agents                            @relation(fields: [agentId], references: [id], onDelete: NoAction)
  customers             customers                         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizations         organizations                     @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  raw_ingest_events     raw_ingest_events                 @relation(fields: [rawIngestEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signals               signals?                          @relation(fields: [signalId], references: [id])
  subscriptions         subscriptions?                    @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matters               matters?                          @relation(fields: [matterId], references: [id], onDelete: SetNull)
  signal_event_services signal_event_services[]

  /// Per-org NULL-safe unique = the dedup index. Scoped by org so the
  /// SAME key value under two different org API keys never collides cross-tenant;
  /// it IS the lookup index the pre-check's findFirst rides, and the constraint
  /// the concurrent-double-POST race lands a P2002 on.
  @@unique([organizationId, idempotencyKey], map: "uq_signal_events_org_idempotency")
  @@index([agentId], map: "idx_signal_events_agent")
  @@index([customerExternalId], map: "idx_signal_events_customer")
  @@index([customerId, subscriptionId], map: "idx_signal_events_customer_subscription")
  @@index([usageDate], map: "idx_signal_events_date")
  @@index([eventProcessed], map: "idx_signal_events_event_processed")
  @@index([organizationId], map: "idx_signal_events_org")
  @@index([environment], map: "idx_signal_events_environment")
  /// Every cost/revenue read (getCostMetrics, getRevenueMetrics,
  /// getProfitabilityAnalytics, the SQL GROUP BY resolver) filters by
  /// organizationId + a usageDate range in the SAME query. The separate
  /// single-column indexes above only ever satisfy one side of that predicate;
  /// this composite turns it into one range scan (equality on the leading
  /// column, range on the second).
  @@index([organizationId, usageDate], map: "idx_signal_events_org_usage_date")
  /// The Unassigned count (WHERE matterId IS NULL) and every per-matter
  /// rollup filter org + matterId in the same query; one composite serves both.
  @@index([organizationId, matterId], map: "idx_signal_events_org_matter")
}

