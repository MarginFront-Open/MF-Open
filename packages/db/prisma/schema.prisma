  agents        agents        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  pricing_plans pricing_plans @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([agentId, planId])
  @@index([agentId])
  @@index([planId])
}

model pricing_strategies {
  id                 String                                    @id @db.Uuid
  name               String                                    @db.VarChar(255)
  agentId            String                                    @db.Uuid
  orgId              String                                    @db.Uuid
  planId             String                                    @db.Uuid
  signalId           String?                                   @db.Uuid
  tags               Json?                                     @default("[]")
  chargeType         enum_pricing_strategies_chargeType
  pricingModel       enum_pricing_strategies_pricingModel?
  billingFrequency   enum_pricing_strategies_billingFrequency?
  tiers              Json?
  /// Money in dollars (CANON U1). 6 decimals for fractional-cent per-unit pricing (e.g., $0.0001 per API call).
  rate               Decimal?                                  @db.Decimal(18, 6)
  /// Per-metric burn rates for a credit_pool strategy — a map
  /// {signalId: creditsPerUnit}. Pool membership = {this row's signalId} ∪
  /// keys(creditRates); a missing key on the pool's own signal means rate 1.
  /// NULL = single-metric pool, one credit per unit. Do NOT
  /// reuse `rate` above for this: that column is DOLLARS (CANON U1), this map
  /// is CREDITS per usage unit. Validated by credit-pool-tiers.ts at every
  /// write lane; read through memberRate (credit-ledger.ts), never directly.
  creditRates        Json?
  active             Boolean?                                  @default(true)
  minimumCommitment  Int?
  createdAt          DateTime                                  @db.Timestamptz(6)
  updatedAt          DateTime                                  @db.Timestamptz(6)
  deletedAt          DateTime?                                 @db.Timestamptz(6)
  invoice_line_items invoice_line_items[]
  agents             agents                                    @relation(fields: [agentId], references: [id], onDelete: NoAction)
  organizations      organizations                             @relation(fields: [orgId], references: [id], onDelete: NoAction)
  pricing_plans      pricing_plans                             @relation(fields: [planId], references: [id], onDelete: Cascade)
  signals            signals?                                  @relation(fields: [signalId], references: [id])

  /// The ingest credit-pool membership check (findCreditPoolStrategy)
  /// runs a per-event findFirst by planId; this index keeps that hot-path
  /// lookup off a sequential scan.
  @@index([planId])
}

model raw_ingest_events {
  id             String                        @id @db.Uuid
  organizationId String                        @db.Uuid
  payload        Json
  status         enum_raw_ingest_events_status @default(PENDING)
