  createdAt                         DateTime                         @db.Timestamptz(6)
  updatedAt                         DateTime                         @db.Timestamptz(6)
  deletedAt                         DateTime?                        @db.Timestamptz(6)
  nextRecurringInvoiceAt            DateTime                         @db.Timestamptz(6)
  nextUsageInvoiceAt                DateTime                         @db.Timestamptz(6)
  customCycleDays                   Int?
  currentSubscriptionDraftInvoiceId String?                          @db.Uuid
  currentUsageDraftInvoiceId        String?                          @db.Uuid
  subscriptionInvoiceIssuanceDate   DateTime?                        @db.Timestamptz(6)
  seatsCount                        Int?                             @default(0)
  seatsInfo                         Json?                            @default("{}")
  billingDay                        Int?
  netTerms                          Int?                             @default(30)
  autoCollectPayment                Boolean?                         @default(false)
  invoiceMemo                       String?
  organizationId                    String?                          @db.Uuid
  billingModel                      enum_subscriptions_billingmodel? @default(subscription)
