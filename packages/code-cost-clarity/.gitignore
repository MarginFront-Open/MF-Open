# Build output (regenerated by `npm run build`).
dist/

# Never commit secrets or local runtime files. The connector keeps these in
# ~/.marginfront-ccc/ on each engineer's machine, but guard the package dir too
# in case anyone runs a capture or drops an .env in here during development.
.env
otelcol-contrib
*.tar.gz
*.jsonl
collector.log
collector.pid

# Real captured telemetry snapshots can contain real account emails.
*-otlp.json
real-telemetry*.json
capture*.json
