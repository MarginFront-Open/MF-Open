# =============================================================================
# API (NestJS) settings
# =============================================================================
# Copy this file to apps/api-nest/.env and fill in the REQUIRED block.
# Everything under OPTIONAL can stay empty: the feature it controls is turned
# off (or uses the default shown) until you set it.
#
# The API checks the required values when it starts and refuses to start with
# a message naming anything missing.


# =============================================================================
# REQUIRED
# =============================================================================

# Postgres connection the API reads and writes. Change it to point at your own
# database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"

# Direct (non-pooled) connection used by Prisma migrations. If you do not use a
# connection pooler, set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/DBNAME"

# 32-byte key that encrypts stored payment-provider secrets. Generate once with
# `openssl rand -base64 32` and never change it: rows encrypted with the old
# key become unreadable. The API refuses to start without a valid one.
ENCRYPTION_KEY=

# Address of your dashboard. Every link in emails and every checkout redirect
# is built from it. Change it when the dashboard moves to a new domain.
FRONTEND_URL=http://localhost:3000

# Address of the dashboard's sign-in server, used to check dashboard sessions.
# Usually the same as FRONTEND_URL.
BETTER_AUTH_URL=http://localhost:3000

# Shared secret your scheduler sends as "Authorization: Bearer <value>" to the
# cron endpoints (invoicing and overdue marking). The API starts
# without it, but then every scheduled call is refused and no invoices are
# issued. The dashboard needs the same value. Generate with `openssl rand -hex 24`.
CRON_SECRET=


# =============================================================================
# OPTIONAL: server
# =============================================================================

# "production" on a real deployment; "development" locally.
NODE_ENV=development

# Port the API listens on. Default 4000.
PORT=4000

# URL prefix for every route. Default v1. Change only if a proxy needs it.
API_PREFIX=v1

# "debug" for verbose logs including database queries; anything else for normal logs.
LOG_LEVEL=info

# Comma-separated browser origins allowed to send cookies (your dashboard).
# Wildcards like https://*-yourteam.example.com are allowed. Requests with an
# API key work from any origin regardless.
CORS_ORIGIN=http://localhost:3000

# Name shown in email footers and on invoices that have no organization
# branding. Default "Usage Billing". Set it to your product or company name.
PRODUCT_NAME=

# Support address quoted in some API error messages. Leave empty to quote none.
SUPPORT_EMAIL=

# Address of the customer portal used in portal login links. Defaults to
# BETTER_AUTH_URL. Set it if the portal runs on its own host.
PORTAL_BASE_URL=

# Platform-set values the API also reads; do not set them by hand:
# VERCEL, AWS_LAMBDA_FUNCTION_NAME, VERCEL_GIT_COMMIT_SHA.


# =============================================================================
# OPTIONAL: email (Resend)
# =============================================================================
# With RESEND_API_KEY empty, email is off: the API runs normally, logs one
# warning at startup, and logs each email it would have sent instead of
# sending it. Manual invoice sends and reminders answer with an error saying
# email is off rather than claiming success.

# Resend API key. Set it to turn email on.
RESEND_API_KEY=

# Sender for operator emails (alerts, merchant notifications). Required once
# RESEND_API_KEY is set; must be on a domain you verified in Resend.
RESEND_FROM_EMAIL=

# Sender for emails to your customers' customers (invoices, receipts). Use a
# no-reply address. Defaults to RESEND_FROM_EMAIL.
RESEND_INVOICE_FROM_EMAIL=

# =============================================================================
# OPTIONAL: rate limiting and Redis
# =============================================================================

# Redis for rate-limit counters, webhook de-duplication, failure alerts and the
# failed-key throttle. Without it a single API process works fine with
# in-memory counters; run Redis as soon as you run more than one process.
# REDIS_URL_REDIS_URL is also accepted (Vercel/Upstash naming) and wins if set.
REDIS_URL=

# What to do when the rate limiter itself fails (usually Redis unreachable):
#   closed-anonymous (default) refuse unauthenticated requests with a 503 and
#                    let requests with a valid key or session through
#   closed           refuse every rate-limited request with a 503
#   open             let everything through, with no rate limit
# Cron and payment-webhook routes are never refused.
RATE_LIMIT_STORE_FAILURE_MODE=closed-anonymous


# =============================================================================
# OPTIONAL: payments
# =============================================================================
# Each organization normally connects its own Stripe account in the dashboard
# with its own keys; these values are only for the platform-level flows named
# below.

# Platform Stripe key and webhook secret. Used for Stripe Connect and to verify
# webhooks sent to /v1/webhooks/stripe (and to /v1/webhooks/stripe/<org ID>
# when that organization has no active Stripe connection of its own).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Client ID of your Stripe Connect platform. Needed for "Connect with Stripe".
STRIPE_CONNECT_CLIENT_ID=


# =============================================================================
# OPTIONAL: alerts to Slack
# =============================================================================
# Needs Redis. Unset webhook means no Slack alerts; per-request logs still work.

# Slack incoming-webhook URL for customer-failure alerts.
AUTH_FAILURE_SLACK_WEBHOOK_URL=

# Repeated rejected API keys from one IP: alert after THRESHOLD failures within
# WINDOW_SECONDS, then at most once per COOLDOWN_SECONDS. Defaults 5 / 900 / 3600.
AUTH_FAILURE_ALERT_THRESHOLD=5
AUTH_FAILURE_ALERT_WINDOW_SECONDS=900
AUTH_FAILURE_ALERT_COOLDOWN_SECONDS=3600

# Same three knobs for rejected usage data (400/422). Defaults 5 / 900 / 3600.
CUSTOMER_FAILURE_BAD_DATA_THRESHOLD=5
CUSTOMER_FAILURE_BAD_DATA_WINDOW_SECONDS=900
CUSTOMER_FAILURE_BAD_DATA_COOLDOWN_SECONDS=3600

# Same three knobs for publishable keys that try to write (403). Defaults 5 / 900 / 3600.
CUSTOMER_FAILURE_FORBIDDEN_THRESHOLD=5
CUSTOMER_FAILURE_FORBIDDEN_WINDOW_SECONDS=900
CUSTOMER_FAILURE_FORBIDDEN_COOLDOWN_SECONDS=3600

# Same three knobs for rate-limited callers (429). Defaults 50 / 300 / 21600.
CUSTOMER_FAILURE_RATE_LIMIT_THRESHOLD=50
CUSTOMER_FAILURE_RATE_LIMIT_WINDOW_SECONDS=300
CUSTOMER_FAILURE_RATE_LIMIT_COOLDOWN_SECONDS=21600

# Minimum seconds between "a revoked key is still in use" emails per
# organization. Default 3600.
REVOKED_KEY_NOTICE_COOLDOWN_SECONDS=3600


# =============================================================================
# OPTIONAL: failed-key throttle
# =============================================================================
# After too many failed API-key attempts from one IP, further failures get 429
# instead of 401. Valid keys are never affected. Needs Redis; off without it.

# "false" turns the throttle off (use if a shared office IP gets caught).
AUTH_FAILURE_THROTTLE_ENABLED=true

# Failed attempts per IP within the window before 429s start. Default 50. Keep
# it above AUTH_FAILURE_ALERT_THRESHOLD or the alert never reaches its count.
AUTH_FAILURE_THROTTLE_THRESHOLD=50

# Counting window and block length in seconds. Default 900.
AUTH_FAILURE_THROTTLE_WINDOW_SECONDS=900

# Milliseconds to wait for Redis before letting the request through uncounted.
# Default 400.
AUTH_FAILURE_THROTTLE_TIMEOUT_MS=400


# =============================================================================
# OPTIONAL: error tracking (off unless you set your own keys)
# =============================================================================

# Your Sentry project's DSN. Empty means no error reports are sent anywhere.
SENTRY_DSN=

# Environment name attached to Sentry reports. Default "development".
SENTRY_ENVIRONMENT=development


# =============================================================================
# OPTIONAL: onboarding assistant
# =============================================================================

# OpenAI key and model for the onboarding assistant that reads a company's
# website. Empty key turns the assistant off. Default model gpt-4o-2024-08-06.
OPENAI_API_KEY=
OPENAI_MODEL=

# Firecrawl key for fetching the website the onboarding assistant reads, and
# its timeout in milliseconds (default 30000). Empty key turns fetching off.
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=
