<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Invoice {{invoice.invoiceNumber}}</title>
    <!-- Tailwind utilities below are pre-compiled inline; run `npm run build:invoice-css --workspace=@marginfront/api-nest`
         after adding or changing Tailwind classes in this template. -->
