{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "installCommand": "npm install --prefix=../.. --production=false",
  "buildCommand": "npx prisma generate --schema=../../packages/db/prisma/schema.prisma && npm run build --prefix=../../packages/db && rm -rf dist && $(cd ../.. && pwd)/node_modules/.bin/nest build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }],
  "env": {
    "VERCEL": "1"
  },
  "crons": [
    {
      "path": "/v1/subscriptions/cron/dispatch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/v1/subscriptions/cron/mark-overdue",
      "schedule": "0 5 * * *"
    }
  ]
}
