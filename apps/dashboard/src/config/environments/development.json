{
  "$schema": "../schema.json",
  "_description": "Development environment configuration - Local development overrides",
  "_extends": "base",

  "api": {
    "baseUrl": "http://localhost:4000/v1",
    "timeout": 60000,
    "retryAttempts": 1
  },

  "features": {
    "useMockInvoices": false,
    "enableAnalytics": false,
    "enableSentry": false,
    "enableBetterStack": false,
    "debugMode": true
  },

  "auth": {
    "betterAuthUrl": "http://localhost:3000",
    "trustedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:4000"
    ]
  },

  "logging": {
    "level": "debug",
    "enableConsole": true,
    "enableRemote": false
  }
}
