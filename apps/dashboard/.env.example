# =============================================================================
# MarginFront dashboard: environment variables
# =============================================================================
# Copy this file to .env.local in apps/dashboard and fill in the REQUIRED
# block. Everything under OPTIONAL can stay empty: each feature it controls
# switches itself off (or hides its link) when its variable is unset.
#
# NEXT_PUBLIC_ variables are copied into the browser bundle when you run
# `next build`. Changing one means rebuilding, and you must never put a
# secret in one.

# =============================================================================
# REQUIRED
# =============================================================================

# Postgres connection string for the MarginFront database (the same one the
# API uses). Change it for every environment you run.
DATABASE_URL="postgresql://user:password@localhost:5432/marginfront"

# Random string that signs sign-in sessions. Generate one with
# `openssl rand -hex 32`. Change it only to sign everyone out.
AUTH_SECRET=""

# Public address of this dashboard, used by the sign-in server. Change it to
# your real https address when you deploy.
BETTER_AUTH_URL="http://localhost:3000"

# Same address, readable by the browser. Keep it equal to BETTER_AUTH_URL.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Address of your MarginFront API, including /v1. The dashboard calls it and
# also prints it in every copy-paste code sample. Change it when you deploy.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/v1"

# Shared secret between the dashboard and the API for invoice generation. Set
# the same value on both apps (`openssl rand -hex 24`).
CRON_SECRET=""

# Resend key for sign-in codes, magic links, invites, invoices and the welcome
# email. For local development without email, see SKIP_OTP_EMAIL below.
RESEND_API_KEY=""

# Sender for team-facing email (sign-in codes, invites, welcome). Must be on a
# domain you verified in Resend.
RESEND_FROM_EMAIL="Your Company <team@yourdomain.com>"

# =============================================================================
# OPTIONAL: your branding and links
# =============================================================================
# Each of these is empty by default, and the element that would show it is
# hidden, so nothing points at anyone else's site.

# Your organisation's name, shown in footers ("© 2026 Your Company") and as
# the welcome email signature. Unset hides the copyright line.
NEXT_PUBLIC_COMPANY_NAME=""

# Support address quoted in the footer of sign-in and invitation emails.
# Unset hides it.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Your docs site, if you host a copy of the MarginFront docs. The dashboard
# appends paths such as /sdk/tracking-events. Unset hides every docs link and
# points the code samples at the READMEs in the source instead.
NEXT_PUBLIC_DOCS_URL=""

# Links shown under customer-portal sign-in as "By continuing, you agree to
# our Terms and Privacy Policy". Each one is shown only when set.
NEXT_PUBLIC_TERMS_URL=""
NEXT_PUBLIC_PRIVACY_URL=""

# The git URL people clone to build the SDK, MCP server and Code Cost Clarity
# meter: the address you got MarginFront from, or your own fork. There is no
# built-in address. While this is empty, the install commands the dashboard
# shows your teammates say "<your MarginFront source URL>" and cannot be run,
# and the "Source code" links are plain text. Set it before you hand out the
# install kit.
NEXT_PUBLIC_SOURCE_REPO_URL=""

# Your company website. Read into the dashboard config; nothing displays it
# today.
NEXT_PUBLIC_COMPANY_WEBSITE=""

# =============================================================================
# OPTIONAL: email
# =============================================================================

# NOTE (no setting to change): the customer portal's sign-in limits count
# requests per caller address, read from the X-Forwarded-For header. Run the
# dashboard behind a reverse proxy that OVERWRITES that header with the real
# client address (Vercel and most hosts do). Behind a proxy that only appends
# to it, a caller can dodge the per-address limit; with no proxy at all, every
# caller shares one limit, so ten requests a minute from anyone pause portal
# sign-in for everyone. The limit of five links an hour per email address
# holds either way.

# Sender for mail your customers receive (portal links, invoices). Use a
# no-reply address so replies don't land in your team's inbox. Falls back to
# RESEND_FROM_EMAIL.
RESEND_INVOICE_FROM_EMAIL=""

# Local development only. Set to true to print sign-in codes and magic links
# in the server log instead of emailing them, so you can sign in without a
# Resend key. Honoured only when NODE_ENV is not production, BETTER_AUTH_URL
# is a localhost address and the request itself arrives on localhost.
# Anywhere else the switch is ignored, the server logs an error and the email
# is sent as normal. There is no built-in development sign-in code.
SKIP_OTP_EMAIL=""
SKIP_MAGIC_LINK_EMAIL=""

# =============================================================================
# OPTIONAL: sign-in
# =============================================================================

# Extra addresses the sign-in server accepts requests from, comma-separated.
# Add your production address and any other host that serves this dashboard.
AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# "Continue with Google" / GitHub. Leave both halves empty to turn a provider
# off.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare Turnstile bot check on the sign-in forms. Off when the secret is
# empty. When you turn it on, list the hostnames this dashboard is served
# from in TURNSTILE_ALLOWED_HOSTNAMES (comma-separated), or every check fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES=""

# =============================================================================
# OPTIONAL: customer portal
# =============================================================================

# Address of the customer billing portal. Defaults to
# http://portal.localhost:3000 (add portal.localhost to /etc/hosts locally).
PORTAL_BASE_URL=""

# Where a portal visit with no organisation in the path goes. Unset answers
# with a plain 404.
PORTAL_FALLBACK_URL=""

# How long a portal session lasts, in milliseconds. Default is one hour.
PORTAL_SESSION_DURATION_MS=""

# =============================================================================
# OPTIONAL: other server addresses
# =============================================================================

# The API address as seen from this server, when it differs from the public
# one (for example a private network name). Falls back to
# NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=""

# Address put in "pay this invoice" links inside invoice emails. Falls back
# to NEXT_PUBLIC_BETTER_AUTH_URL.
FRONTEND_URL=""

# Address Stripe sends people back to after connecting an account, and the
# welcome email's dashboard button when BETTER_AUTH_URL is unset.
NEXT_PUBLIC_APP_URL=""

# =============================================================================
# OPTIONAL: integrations
# =============================================================================

# Google Gemini, for reading pricing pages during onboarding. Off when empty.
# GOOGLE_AI_API_KEY is accepted as another name for the same key.
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""
# Gemini model to use. Default is gemini-2.5-flash.
GEMINI_MODEL=""

# =============================================================================
# OPTIONAL: error tracking and logs (all off when empty)
# =============================================================================
# Nothing is sent anywhere unless you put your own account's keys here.

# Your Sentry project's DSN. Empty means Sentry never starts.
NEXT_PUBLIC_SENTRY_DSN=""
# Replays mask all text and inputs and block media by default. Set to true to
# record readable text and media (inputs stay masked). Read at build time.
NEXT_PUBLIC_SENTRY_REPLAY_UNMASK=""
# Build-time only: upload source maps to your Sentry project.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Comma-separated domains whose signed-in users are tagged is_internal in
# Sentry, so your own team can be filtered out. Empty tags nobody.
NEXT_PUBLIC_INTERNAL_EMAIL_DOMAINS=""

# BetterStack log source token. Empty means logs stay in the console.
NEXT_PUBLIC_BETTERSTACK_SOURCE_TOKEN=""

# =============================================================================
# OPTIONAL: development switches
# =============================================================================

# development, preview, production or test. Picks the config file under
# src/config/environments and turns Sentry off in development.
NEXT_PUBLIC_APP_ENV="development"

# Overrides the debugMode flag in the dashboard config. Nothing acts on the
# flag today.
NEXT_PUBLIC_DEBUG_MODE=""

# true makes the invoices screen use built-in sample data instead of the API.
NEXT_PUBLIC_USE_MOCK_INVOICES=""

# Set by your host or by Next.js itself; you do not set these: NODE_ENV,
# NEXT_RUNTIME, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA,
# NEXT_PUBLIC_VERCEL_URL, NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA.
